---
// Modal component for file preview with navigation
---

<div id="previewModal" class="modal" style="display: none;">
  <div class="modal-backdrop"></div>
  <div class="modal-content">
    <div class="modal-header">
      <h3 id="modalTitle">Archivo</h3>
      <div class="modal-actions">
        <a id="modalDownload" href="#" class="modal-btn" download>
          <i data-lucide="download"></i>
        </a>
        <button id="modalClose" class="modal-btn">
          <i data-lucide="x"></i>
        </button>
      </div>
    </div>
    <div class="modal-body" id="modalBody">
      <div class="loading-spinner">
        <i data-lucide="loader" class="spinner"></i>
      </div>
    </div>
    <div class="modal-footer" id="modalFooter"></div>
    <button id="prevFileBtn" class="nav-btn prev-btn">
      <i data-lucide="chevron-left"></i>
    </button>
    <button id="nextFileBtn" class="nav-btn next-btn">
      <i data-lucide="chevron-right"></i>
    </button>
  </div>
</div>

<style>
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    position: relative;
    background: white;
    border-radius: 12px;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .modal-header {
    padding: 1.5rem;
    border-bottom: 1px solid #e9ecef;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: #1a1a1a;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .modal-actions {
    display: flex;
    gap: 8px;
  }

  .modal-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f8f9fa;
    border: none;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .modal-btn:hover {
    background: #e9ecef;
    color: #1a1a1a;
  }

  .modal-btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  .modal-body {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    background: #f8f9fa;
  }

  :global(.preview-image) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(.preview-video) {
    max-width: 100%;
    max-height: 100%;
  }

  .loading-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spinner {
    animation: spin 1s linear infinite;
  }

  .spinner :global(svg) {
    width: 48px;
    height: 48px;
    color: #4285f4;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  :global(.no-preview) {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  :global(.no-preview-icon) {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    color: #ccc;
  }

  :global(.no-preview-icon svg) {
    width: 100%;
    height: 100%;
  }

  :global(.no-preview h3) {
    font-size: 1.2rem;
    margin: 0 0 10px 0;
    color: #1a1a1a;
  }

  :global(.download-link) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 1rem;
    padding: 0.7rem 1.5rem;
    background: #4285f4;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  :global(.download-link:hover) {
    background: #357ae8;
  }

  :global(.download-link svg) {
    width: 18px;
    height: 18px;
  }

  .modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid #e9ecef;
    background: white;
  }

  :global(.file-metadata) {
    display: flex;
    gap: 20px;
    font-size: 0.9rem;
    color: #666;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    color: #4285f4;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .nav-btn:hover {
    background: white;
    transform: translateY(-50%) scale(1.1);
  }

  .nav-btn :global(svg) {
    width: 24px;
    height: 24px;
  }

  .prev-btn {
    left: 20px;
  }

  .next-btn {
    right: 20px;
  }

  @media (max-width: 768px) {
    .modal-content {
      max-width: 100vw;
      max-height: 100vh;
      border-radius: 0;
    }

    .nav-btn {
      width: 40px;
      height: 40px;
    }

    .prev-btn {
      left: 10px;
    }

    .next-btn {
      right: 10px;
    }
  }
</style>
