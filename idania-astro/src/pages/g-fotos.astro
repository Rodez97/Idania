---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession } from '../lib/session';
import { dbOperations } from '../lib/db';

// Verificar sesión
const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/api/auth/login');
}

// Obtener usuario actual
const currentUser = await dbOperations.getUserById(session.userId);
if (!currentUser) {
  return Astro.redirect('/api/auth/login');
}

// Verificar si ya tiene permisos de Google Photos
const hasPhotosAccess = currentUser.photos_access_token && currentUser.photos_refresh_token;
---

<BaseLayout title="Google Photos">
  <div class="photos-container">
    <div class="photos-header">
      <h1>Google Photos</h1>
      <p class="subtitle">Accede a tus fotos de Google Photos</p>
    </div>

    <div class="photos-content">
      {hasPhotosAccess ? (
        <div class="access-granted">
          <div class="icon-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h2>Permisos otorgados</h2>
          <p>Ya tienes acceso a Google Photos con la cuenta <strong>{currentUser.email}</strong></p>
          <button class="btn-revoke" id="revokeBtn">
            Revocar permisos
          </button>
        </div>
      ) : (
        <div class="request-access">
          <div class="icon-photos">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <h2>Acceso a Google Photos</h2>
          <p>Para ver tus fotos, necesitamos tu permiso para acceder a Google Photos</p>
          <p class="account-info">Cuenta: <strong>{currentUser.email}</strong></p>
          <a href="/api/auth/photos-login" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Dar permisos de Google Photos
          </a>
        </div>
      )}
    </div>
  </div>

  <style>
    .photos-container {
      max-width: 600px;
      margin: 0 auto;
      padding: 2rem;
    }

    .photos-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .photos-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 0.5rem;
    }

    .subtitle {
      font-size: 1.1rem;
      color: #666;
    }

    .photos-content {
      background: white;
      border-radius: 16px;
      padding: 3rem;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    }

    .request-access,
    .access-granted {
      text-align: center;
    }

    .icon-photos,
    .icon-success {
      margin-bottom: 1.5rem;
      color: #4285f4;
    }

    .icon-success {
      color: #34a853;
    }

    .request-access h2,
    .access-granted h2 {
      font-size: 1.75rem;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 1rem;
    }

    .request-access p,
    .access-granted p {
      font-size: 1rem;
      color: #666;
      margin-bottom: 1rem;
      line-height: 1.6;
    }

    .account-info {
      font-size: 0.95rem;
      color: #444;
      margin-top: 1.5rem;
      margin-bottom: 2rem;
    }

    .account-info strong {
      color: #1a1a1a;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: #4285f4;
      color: white;
      padding: 1rem 2rem;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
    }

    .btn-primary:hover {
      background: #357ae8;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
    }

    .btn-primary svg {
      flex-shrink: 0;
    }

    .btn-revoke {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #dc2626;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
      border: none;
      cursor: pointer;
      margin-top: 1.5rem;
    }

    .btn-revoke:hover {
      background: #b91c1c;
      transform: translateY(-2px);
    }

    @media (max-width: 640px) {
      .photos-container {
        padding: 1rem;
      }

      .photos-content {
        padding: 2rem 1.5rem;
      }

      .photos-header h1 {
        font-size: 2rem;
      }
    }
  </style>

  <script>
    const revokeBtn = document.getElementById('revokeBtn');

    if (revokeBtn) {
      revokeBtn.addEventListener('click', async () => {
        if (!confirm('¿Estás seguro de que quieres revocar el acceso a Google Photos?')) {
          return;
        }

        try {
          const response = await fetch('/api/auth/photos-revoke', {
            method: 'POST',
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert('Error al revocar permisos');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Error al revocar permisos');
        }
      });
    }
  </script>
</BaseLayout>
