---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Iniciar Sesión ♡">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="hibiscus-icon">
                    <img src="/images/hibiscus.webp" alt="Flor de Hibisco" />
                </div>
                <h1>Para Idania</h1>
                <p class="subtitle">Un espacio especial creado con amor</p>
            </div>

            <div class="login-content">
                <p class="welcome-text">
                    Este es nuestro espacio especial. Solo para nosotros dos ❤️
                </p>

                <a href="/api/auth/login" class="google-login-btn">
                    <svg class="google-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                        <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                        <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                        <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                        <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                    </svg>
                    <span>Entrar con Google</span>
                </a>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 30px;
        padding: 60px 50px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        animation: fadeInUp 0.8s ease;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .hibiscus-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 150px;
        height: 150px;
        margin-bottom: 20px;
        animation: floatAnimation 3s ease-in-out infinite;
    }

    .hibiscus-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 5px 15px rgba(214, 52, 71, 0.3));
    }

    @keyframes floatAnimation {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(5deg); }
    }

    h1 {
        font-family: 'Playfair Display', serif;
        font-size: 3em;
        color: #c94b4b;
        margin-bottom: 10px;
    }

    .subtitle {
        font-size: 1.2em;
        color: #666;
        font-weight: 300;
    }

    .login-content {
        margin-bottom: 30px;
    }

    .welcome-text {
        font-size: 1.1em;
        line-height: 1.6;
        color: #555;
        text-align: center;
        margin-bottom: 30px;
    }

    .google-login-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        width: 100%;
        padding: 18px 30px;
        background: white;
        border: 2px solid #ddd;
        border-radius: 50px;
        font-size: 1.1em;
        font-weight: 600;
        color: #333;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .google-login-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        border-color: #d63447;
    }

    .google-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
    }

    @media (max-width: 768px) {
        .login-card {
            padding: 40px 30px;
        }

        h1 {
            font-size: 2.5em;
        }

        .heart-icon {
            width: 70px;
            height: 70px;
        }

        .heart-icon :global(svg) {
            width: 35px;
            height: 35px;
        }
    }
</style>

<script is:inline>
    // Inicializar iconos de Lucide cuando el DOM esté listo
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    } else {
        // Si lucide aún no está cargado, esperar un poco
        setTimeout(() => {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        }, 100);
    }
</script>
