# Google OAuth Configuration
# Obtener de: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# URL de tu aplicación (cambiar en producción)
PUBLIC_BASE_URL=http://localhost:4321

# Secret para firmar sesiones (genera uno aleatorio para producción)
SESSION_SECRET=change_this_to_a_random_string_in_production

# Firebase Configuration
# Obtener de: https://console.firebase.google.com/ > Project Settings > SDK setup
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
